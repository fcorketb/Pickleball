{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] },
    { "source": "/(sw.js|index.html|)", "headers": [
      { "key": "Cache-Control", "value": "no-cache" }
    ] }
  ]
}
